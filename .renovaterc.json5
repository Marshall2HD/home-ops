{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#9.0.0",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#9.0.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#9.0.0",
    ":timezone(America/New_York)",
  ],
  // main does not require up-to-date branches, and `auto` would
  // still rebase every automerge PR each time main moves
  rebaseWhen: "conflicted",
  fetchChangeLogs: "off",
  prFooter: "",
  gitIgnoredAuthors: ["15093189+Marshall2HD@users.noreply.github.com"],
  platformCommit: "disabled",
  packageRules: [
    // Auto-merge rules
    {
      description: "Auto-merge trusted OCI digests",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["/home-operations/"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      // kritika scores these and fails its status below 4; the platform and
      // data-store components the autopilot always left to marsh stay manual
      description: "Auto-merge app minor and patch updates that pass kritika's gate",
      matchDatasources: ["docker", "helm"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: [
        "!/ceph/",
        "!/rook/",
        "!/cilium/",
        "!/coredns/",
        "!/siderolabs/",
        "!/talos/",
        "!/tuppr/",
        "!/kube-apiserver/",
        "!/kube-controller-manager/",
        "!/kube-proxy/",
        "!/kube-scheduler/",
        "!/kubelet/",
        "!/flux/",
        "!/external-secrets/",
        "!/cloudnative-pg/",
        "!/postgres/",
        "!/langfuse/",
      ],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Leave 0.x minor updates, which are breaking by semver, to marsh",
      matchDatasources: ["docker", "helm"],
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "/^v?0\\./",
      automerge: false,
    },
    {
      description: "Commit Proto digests published by its own CI straight to main",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["ghcr.io/marshall2hd/proto"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      description: "Commit Remedyverse image digests published by its own CI straight to main",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["ghcr.io/marshall2hd/remedyverse"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      description: "Auto-merge high-cadence OCI packages weekly",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/kube-prometheus-stack/"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
      schedule: ["before 6am on Monday"],
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "3 days",
      ignoreTests: false,
    },
    {
      description: "Auto-merge trusted GitHub Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: ["/^actions\\//", "/^renovatebot\\//"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "1 minute",
      ignoreTests: false,
    },
    {
      description: "Auto-merge Grafana dashboards",
      matchDatasources: ["custom.grafana-dashboards"],
      matchUpdateTypes: ["major"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge Renovate Presents",
      matchManagers: ["renovate-config"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    // Grouping rules
    {
      description: "Actions Runner Controller Group",
      groupName: "actions-runner-controller",
      matchDatasources: ["docker"],
      matchPackageNames: ["/gha-runner-scale-set-controller/", "/gha-runner-scale-set/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 5,
    },
    {
      // Scheduled tools stay out: a grouped branch takes its schedule from
      // whichever update sorts first
      description: "Mise Tools Group",
      matchManagers: ["mise"],
      matchDepNames: ["!node", "!oxfmt"],
      groupName: "mise tools",
      groupSlug: "mise-tools",
    },
    {
      description: "Rook-Ceph Group",
      groupName: "rook-ceph",
      matchDatasources: ["docker"],
      matchPackageNames: ["/rook-ceph/", "/rook-ceph-cluster/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      // After the mise tools catch-all so talos wins its own group; unites the
      // mise pin, the factory installer image, and the tuppr upgrade version
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["siderolabs/talos"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Hold Rook-Ceph at the supported v1.20 patch series",
      matchPackageNames: ["/rook-ceph/", "/rook-ceph-cluster/"],
      allowedVersions: ">=1.20.0 <1.21.0",
    },
    {
      // MAM's tracker answers 5.3.0 with "client not allowed"; lift this once
      // MAM lists 5.3 as an approved client
      description: "Hold qBittorrent at 5.2.x, which MyAnonamouse accepts",
      matchPackageNames: ["/qbittorrent/"],
      allowedVersions: "<5.3.0",
    },
    {
      description: "1Password CLI is not resolvable on GitHub, bump manually",
      matchManagers: ["mise"],
      matchDepNames: ["1password-cli"],
      enabled: false,
    },
    // Scheduling rules
    {
      description: "High-cadence mise tools monthly",
      matchManagers: ["mise"],
      matchDepNames: ["node", "oxfmt"],
      schedule: ["before 3am on the first day of the month"],
    },
    // Labeling rules
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
  ],
}
